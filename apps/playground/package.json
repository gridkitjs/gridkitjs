{
  "name": "playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint src tests-ct playwright",
    "test:e2e": "playwright test -c playwright-ct.config.ts",
    "test:e2e:ui": "playwright test -c playwright-ct.config.ts --ui",
    "test:e2e:coverage": "node -e \"fs.rmSync('playwright/.cache', { recursive: true, force: true })\" && cross-env VITE_COVERAGE=true playwright test -c playwright-ct.config.ts && nyc report --check-coverage --lines 80 --statements 80 --functions 80 --reporter=text --reporter=html --reporter=json-summary"
  },
  "dependencies": {
    "@gridkitjs/core": "workspace:*",
    "@gridkitjs/react": "workspace:*",
    "@gridkitjs/theme-tailwind": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "nyc": "^18.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-istanbul": "^9.0.1"
  }
}
