{
  "name": "@gridkitjs/react",
  "version": "0.7.0",
  "description": "React data-grid components built on @gridkitjs/core.",
  "license": "MIT",
  "author": "Blagoja Blazhevski",
  "homepage": "https://github.com/blagojablazhevski/gridkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blagojablazhevski/gridkit.git",
    "directory": "packages/react"
  },
  "keywords": [
    "datagrid",
    "grid",
    "table",
    "react",
    "headless",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@gridkitjs/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
