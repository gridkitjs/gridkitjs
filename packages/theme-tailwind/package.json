{
  "name": "@gridkitjs/theme-tailwind",
  "version": "0.11.0",
  "description": "Tailwind v4 theme for GridKit — palette tokens, dark mode and grid styles.",
  "license": "MIT",
  "author": "Blagoja Blazhevski",
  "homepage": "https://github.com/gridkitjs/gridkitjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gridkitjs/gridkitjs.git",
    "directory": "packages/theme-tailwind"
  },
  "keywords": [
    "gridkit",
    "datagrid",
    "tailwind",
    "tailwindcss",
    "theme",
    "css"
  ],
  "exports": {
    "./styles.css": "./src/styles.css",
    "./tokens.json": "./src/tokens.json",
    "./presets/*": "./src/presets/*"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"scripts/*.test.mjs\"",
    "docs:tokens": "node scripts/write-token-docs.mjs"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.3"
  }
}
