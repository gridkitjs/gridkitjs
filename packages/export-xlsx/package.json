{
  "name": "@gridkitjs/export-xlsx",
  "version": "0.0.1",
  "description": "An Excel (.xlsx) export writer for GridKit: typed numbers and dates, number formats, a frozen header, column widths, groups and totals.",
  "license": "MIT",
  "author": "Blagoja Blazhevski",
  "homepage": "https://github.com/blagojablazhevski/gridkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blagojablazhevski/gridkit.git",
    "directory": "packages/export-xlsx"
  },
  "keywords": [
    "datagrid",
    "grid",
    "table",
    "export",
    "excel",
    "xlsx",
    "typescript",
    "framework-agnostic"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@gridkitjs/core": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
